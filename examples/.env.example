# Angel One API Credentials
# ---------------------------
# Copy this file to .env and fill in your credentials
#
# Getting credentials:
#   1. Create Angel One SmartAPI account: https://smartapi.angelone.in/
#   2. Generate API key from the dashboard
#   3. Get your client code (same as your Angel One user ID)
#   4. Your password is your 4-digit trading PIN
#   5. Set up TOTP and save the secret key
#
# TOTP Setup:
#   - Enable TOTP in your Angel One account settings
#   - When setting up, you'll receive a secret key (base32 encoded)
#   - Store this secret key in ANGEL_TOTP_KEY
#   - The SDK will auto-generate TOTP codes using this key

ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_code_here
ANGEL_PIN=your_trading_pin_here
ANGEL_TOTP_SECRET=your_totp_secret_key_here
